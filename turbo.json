{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "*.js",
        "*.js.map",
        "*.cjs",
        "*.cjs.map",
        "*.d.ts",
        "*.d.cts",
        "plugins/**",
        "dist/**",
        "storybook-static/**"
      ],
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
